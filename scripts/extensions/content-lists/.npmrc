# Peer dependencies (react, superdesk-ui-framework, lodash, @sourcefabric/common)
# are provided by the host application and must not be installed locally —
# a second React copy would break rendering. This also makes the plain
# `npm install` that @superdesk/build-tools runs for extension dependencies
# work without hitting ERESOLVE on the react peer range.
legacy-peer-deps=true
