{
  "private": true,
  "dependencies": {
    "@superdesk/build-tools": "file:../../build-tools",
    "superdesk-core": "file:../../"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/request": "^2.48.12",
    "grunt": "1.3.0",
    "http-server": "14.1.1",
    "monocart-reporter": "^2.12.5",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "scripts": {
    "check-types": "tsc --noEmit --resolveJsonModule",
    "build": "npm run check-types && npx @superdesk/build-tools build-root-repo ./",
    "server": "grunt server",
    "playwright": "playwright test --workers 1",
    "playwright-interactive": "playwright test --ui",
    "start-client-server": "http-server dist -p ${CLIENT_PORT:-9000} -s &",
    "start-test-server": "cd ../server && docker-compose build && docker-compose up -d",
    "stop-test-server": "cd ../server && docker-compose stop"
  }
}
